placed_block: rcol, l=0.2*m, xsize=0.1*m, ysize=0.1*m, material="W";

gap1: gap, l=0.5*m;
d1: drift, l=0.5*m, aper1=0.1*m;
link_line: line = (gap1, d1);
use, link_line;

p1: placement, bdsimElement="placed_block", referenceElement="gap1",
    x=0.01*m, s=0.02*m;
p2: placement, bdsimElement="placed_block", referenceElement="d1";

beam, particle="proton", kineticEnergy=100*GeV;
option, physicsList="em";
